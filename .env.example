# Copy this file to .env and replace the placeholder values.
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
CLOUDSENTINEL_API_KEY=replace-with-a-strong-api-key
ALERTMANAGER_WEBHOOK_TOKEN=replace-with-a-strong-webhook-token
CLOUDSENTINEL_DISABLE_BACKGROUND_DETECTION=false
CLOUDSENTINEL_FAILED_LOGIN_THRESHOLD=3
CLOUDSENTINEL_TIME_WINDOW_MINUTES=5
CLOUDSENTINEL_PORT_SCAN_THRESHOLD=5
