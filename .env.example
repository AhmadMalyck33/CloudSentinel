# Run `python scripts/generate_env.py` to create .env with generated secrets.
GRAFANA_ADMIN_PASSWORD=
CLOUDSENTINEL_API_KEY=
ALERTMANAGER_WEBHOOK_TOKEN=
CLOUDSENTINEL_DISABLE_BACKGROUND_DETECTION=false
CLOUDSENTINEL_FAILED_LOGIN_THRESHOLD=3
CLOUDSENTINEL_TIME_WINDOW_MINUTES=5
CLOUDSENTINEL_PORT_SCAN_THRESHOLD=5
# Optional login protection settings:
# CLOUDSENTINEL_LOGIN_RATE_LIMIT=20
# CLOUDSENTINEL_MAX_EVENT_FILE_MB=10
# Optional when running outside Docker Compose:
# PROMETHEUS_URL=http://localhost:9090
# Optional exporter settings:
# EXPORTER_INTERVAL_SECONDS=10
# LOG_LEVEL=INFO
